# Copy this file to .env and fill in real values. Never commit .env itself.

# Connection string from Neon / Supabase / your Postgres provider
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the API server listens on
PORT=4000

# Set to "production" when deploying for real. When set, CORS_ORIGIN below becomes mandatory
# (the server refuses to start without it) instead of defaulting to allow-all.
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (your frontend URL).
# REQUIRED if NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173
# If you build the Windows desktop app (see desktop/README.md), add its local server too:
# CORS_ORIGIN=https://your-frontend.com,http://localhost:5173,http://localhost:5174

# Email notifications (optional). Leave blank to disable — the app logs what would have been
# sent instead of failing. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App
# Password (not your normal password) for SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=ronald@roplantservices.com

# WhatsApp Business API (optional). Leave blank to disable — endpoints report clearly that
# they weren't sent instead of failing silently. Requires a Meta-verified WhatsApp Business
# Account: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Your real public HTTPS URL (e.g. https://api.roplantservices.com) — required only for
# attaching an invoice PDF directly, since WhatsApp fetches the file itself and can't reach
# localhost. Without it, invoice sends fall back to a text summary instead of the PDF.
PUBLIC_BASE_URL=
